<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only runtime permission required. No INTERNET or storage permission. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- "camera.any" also covers front-only and external cameras. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- android:hasCode="false": the APK ships no DEX, only Rust native code. -->
    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="@string/app_name"
        android:resizeableActivity="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- android.app.NativeActivity is provided by the platform, so no Java
             or Kotlin wrapper class is needed. -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|navigation|touchscreen"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor">

            <meta-data
                android:name="android.app.lib_name"
                android:value="pure_camera" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
